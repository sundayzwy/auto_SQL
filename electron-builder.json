{
  "appId": "com.autosql.app",
  "productName": "AutoSQL",
  "artifactName": "AutoSQL-${version}-portable.${ext}",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "resources/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "resources",
      "to": "resources"
    }
  ],
  "portable": {
    "artifactName": "AutoSQL-${version}-portable.exe"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  }
}
