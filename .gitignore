# ============================================================
# AutoSQL Git 忽略规则
# ============================================================

# 依赖
node_modules/

# 构建产物
dist/
release/
*.tsbuildinfo

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 操作系统
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE 配置（保留 .eslintrc.js）
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# 环境变量
.env
.env.local
.env.*.local

# 用户数据（Electron 运行时生成）
.auto-sql/

# 打包临时文件
*.dmg
*.pkg
*.blockmap

# 测试覆盖率
coverage/
.nyc_output/

# 临时文件
tmp/
temp/